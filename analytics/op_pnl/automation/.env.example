# ==============================================================
# .env.example — copiar a .env y completar
# ==============================================================

# Grid doc target (de la URL https://grid.adminml.com/d/<DOC_ID>/view)
DOC_ID=01KQZ8ZQHYRPD8ARVFGJ157E9B

# Endpoint Grid (interno MELI, requiere VPN)
GRID_API=https://grid.melioffice.com/api/v1/engine/run
GRID_API_BASE=https://grid.melioffice.com/api/v1

# Skill version del plugin grid-sharing
SKILL_VERSION=3.6.2

# Título del doc + lista de usuarios con quien compartir
DOC_TITLE=OP P&L · Online Payments · Monthly Review
SHARE_WITH=fedlana

# Retry / timeout del upload
MAX_RETRIES=4
TIMEOUT_SEC=60

# Health check
EXPECTED_AGE_HOURS=26
EXPECTED_MIN_BYTES=80000

# Slack DM cuando health_check falla (opcional)
SLACK_WEBHOOK=
NOTIFY_USERS=fedlana
